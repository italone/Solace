{
  "manifest_version": 3,
  "name": "Solace DevTools",
  "version": "0.0.1",
  "description": "Timeline panel for Solace DevTools events.",
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:6174/*", "http://localhost:6174/*"],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": ["http://127.0.0.1:6174/*", "http://localhost:6174/*"],
  "web_accessible_resources": [
    {
      "resources": ["bridge.js"],
      "matches": ["http://127.0.0.1:6174/*", "http://localhost:6174/*"]
    }
  ]
}
