<template>
  <button class="counter" onClick={increment}>
    count: {count.value}
  </button>
</template>

<script>
  import { ref } from "@italone/solace";
  const count = ref(0);
  const increment = () => count.value++;
</script>

<style>
  .counter {
    color: blue;
    font-size: 1.25rem;
    padding: 0.5rem 1rem;
    cursor: pointer;
  }
</style>
